# ═══════════════════════════════════════════════════════════════════════════
# Telegram VPS Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs who can manage servers
# Get your ID from @userinfobot
ADMIN_USER_IDS=123456789,987654321

# ── VPS Provider ──────────────────────────────────
# mock | generic
# Use "mock" for testing. Switch to "generic" for production with a real provider.
VPS_PROVIDER=mock

# Only fill these if VPS_PROVIDER=generic
VPS_API_BASE_URL=https://api.example-vps-provider.com/v1
VPS_API_TOKEN=your-api-token-here
VPS_PLAN_ID=win-2cpu-4gb
VPS_REGION=us-east-1
VPS_IMAGE_ID=windows-server-2022

# ── Database ──────────────────────────────────────
# For local development: sqlite:///data/bot.db
# For Railway production: use PostgreSQL (Railway auto-provides DATABASE_URL)
# Leave blank to use in-memory SQLite (data lost on restart)
DATABASE_URL=sqlite:///data/bot.db

# ── Security ──────────────────────────────────────
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to skip password encryption (not recommended for production)
ENCRYPTION_KEY=

# ── Rate Limiting ──────────────────────────────────
# Cooldown between server creation requests (seconds)
CREATE_RATE_LIMIT_SECONDS=300

# Max active servers per user
MAX_SERVERS_PER_USER=3

# ── Webhook Mode (optional; leave blank for polling) ────────
# Only set this if you want to use webhook instead of polling.
# For Railway: your app's public URL (e.g. https://vps-bot.up.railway.app)
# Leave blank to use polling mode (simpler, recommended for Railway)
WEBHOOK_URL=

# PORT will be auto-set by Railway; you can override here if needed
PORT=8443
